# RunPod Serverless GPU API Configuration (for large coding models e.g., Qwen 3.6 27B)
RUNPOD_ENDPOINT_ID=your_runpod_endpoint_id_here
RUNPOD_API_KEY=your_runpod_api_key_here

# Local Model Configuration (Ollama for instant casual chat)
OLLAMA_MODEL=qwen3:8b

# Optional: GitHub Personal Access Token (Raises GitHub API rate limit from 60/hr to 5000/hr for skill discovery)
# GITHUB_TOKEN=your_github_pat_here
